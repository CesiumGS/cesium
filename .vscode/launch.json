{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Launch dev server",
            "cwd": "${workspaceFolder}",
            "runtimeExecutable": "npm",
            "runtimeArgs": ["run", "dev"],
            "noDebug": true,
            "serverReadyAction": {
                "action": "startDebugging",
                "name": "Launch in Chrome",
                "pattern": "Local:"
            }
        },
        {
            "name": "Launch in Chrome",
            "request": "launch",
            "type": "chrome",
            "url": "http://127.0.0.1:5190",
            "webRoot": "${workspaceFolder}"
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Run the open test file",
            "cwd": "${workspaceFolder}",
            "runtimeExecutable": "npx",
            "runtimeArgs": ["vitest", "run", "${relativeFile}"],
            "console": "integratedTerminal"
        }
    ]
}
