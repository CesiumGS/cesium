/.metadata
/cesium-*.tgz
/packages/**/*.tgz
.directory
.DS_Store
Thumbs.db
.eslintcache

node_modules/
npm-debug.log
npm-debug.log.*
yarn.lock
# pnpm installs (CS-1091): a stray `npm install` would write this.
package-lock.json

# WebStorm user-specific
.idea/workspace.xml
.idea/tasks.xml
.idea/shelf

# Benchmark worktrees of commits (bench/snapshot.mjs)
/.bench/

# Microbenchmark results (bench/run.mjs; machine details)
/bench/results/
# Vite dependency cache of snapshot dev servers
/.vite-bench/

# 2.0's packages' build output (npm run build), and the type check's
# declarations and build info (tsc --build, npm run typecheck)
/packages/*/dist/
/packages/*/.tsbuild/
*.tsbuildinfo

# 2.0's harness at the root (CS-835; these were packages/next/.gitignore's).
# The dev site's build (npm run build:site).
/dist/
/handbook/dist/
# Local secrets (ion access token for the dev-server proxy)
.env.local
.env.*.local
# Design-review screenshots: local only (large, retaken often; never committed)
/examples/*/design-screenshots/
# Python bytecode (importing scripts/frameFixtures.py writes it)
__pycache__/
# Browser checks' screenshots and pages at the root: local only
/design-screenshots/
# The handbook's generated figures (npm run handbook:data); its build goes to handbook/dist/
/handbook/generated/
