exports[`profile invariants > 9. snapshots > intel-uhd-4k: support 1`] = `
{
  "content": {
    "optional": {
      "advancedTranslucency": true,
      "brep": true,
      "labels": true,
      "points": true,
      "splats": true,
      "vectors": true,
    },
    "required": [
      "globe",
      "terrain",
      "imagery",
      "meshes",
    ],
  },
  "features": {
    "aerialPerspective": [
      "march",
      "screen",
      "volume",
    ],
    "ambientOcclusion": [
      "full",
    ],
    "cityLights": [
      "on",
    ],
    "fxaa": [
      "on",
    ],
    "glare": [
      "full",
      "reduced",
      "sources",
    ],
    "lodTransitions": [
      "morph",
      "pop",
    ],
    "msaa": [
      "4x",
      "1x+fxaa",
    ],
    "normals": [
      "exact",
      "linear",
    ],
    "resolution": [
      1,
      0.75,
      0.5,
    ],
    "shadows": [
      "full",
    ],
    "sunDisk": [
      "on",
    ],
    "translucency": [
      "exact",
      "moments32",
      "moments16",
    ],
  },
  "outputs": [
    "color",
    "depth",
    "featureId",
  ],
  "paths": [
    "starSubmission: indirect (an indirect draw's first instance is honored)",
    "textureTranscode: bc7 (BC7 blocks sample on this device)",
    "translucencyLists: per-pixel (a 4× fragment shader's storage writes run once a pixel)",
    "gpuTiming: timestamps (timestamp queries time the passes)",
  ],
  "queries": [
    {
      "backend": "id-targets",
      "kind": "pick",
    },
  ],
  "renderer": "webgpu",
  "updates": "each-tick",
}
`;

