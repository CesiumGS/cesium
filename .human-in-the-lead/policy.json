{
  "schema_version": 1,
  "project": {
    "id": "cesium-2-0",
    "key": "CS"
  },
  "merge": {
    "main_branch": "cesium-2.0-webgpu-poc",
    "fast_checks": [
      "cd packages/next && npm run typecheck",
      "cd packages/next && npx hitld work check"
    ],
    "full_suite": [
      "cd packages/next && npm test"
    ]
  },
  "dispatch": {
    "inline_globs": [
      "packages/next/work/**"
    ]
  },
  "env": {
    "worktree_setup": [
      "npm install --ignore-scripts --no-audit --no-fund --prefer-offline",
      "npx gulp prepare",
      "npx gulp build --workspace @cesium/core",
      "npx gulp build --workspace @cesium/gltf",
      "npx gulp build --workspace @cesium/engine"
    ]
  },
  "ids": {
    "blocks": [
      {
        "name": "second-machine",
        "from": 100000
      }
    ]
  }
}
