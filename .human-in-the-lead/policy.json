{
  "schema_version": 1,
  "project": {
    "id": "cesium-2-0",
    "key": "CS"
  },
  "merge": {
    "main_branch": "cesium-2.0-webgpu-poc",
    "fast_checks": [
      "npm run typecheck",
      "npx hitld work check"
    ],
    "full_suite": [
      "npm test"
    ],
    "mode": "owner",
    "owner_paths": [
      "api/surface.txt",
      "packages/core/src/index.ts",
      "packages/core/src/ir/FORMAT.md",
      "packages/cesium/package.json",
      "package.json",
      ".human-in-the-lead/",
      "AGENTS.md",
      "packages/next/AGENTS.md",
      ".husky/",
      ".github/",
      ".claude/",
      "packages/next/.claude/"
    ]
  },
  "dispatch": {
    "inline_globs": [
      "work/**"
    ]
  },
  "env": {
    "worktree_setup": [
      "npm ci --ignore-scripts --no-audit --no-fund --prefer-offline"
    ]
  },
  "ids": {
    "blocks": [
      {
        "name": "second-machine",
        "from": 100000
      }
    ]
  }
