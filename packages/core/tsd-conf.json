{
  "tags": {
    "allowUnknownTags": false
  },
  "source": {
    "include": [
      "packages/core/Source"
    ],
    "includePattern": ".+\\.js(doc)?$",
    "excludePattern": "(^|\\/|\\\\)_"
  },
  "plugins": [
    "./Tools/jsdoc/cesiumTags",
    "tsd-jsdoc/dist/plugin"
  ],
  "templates": {
    "cleverLinks": true,
    "default": {
      "outputSourceFiles": false
    }
  },
  "opts": {
    "destination": "packages/core",
    "template": "tsd-jsdoc/dist",
    "outFile": "index.d.ts",
    "recurse": true
  }
}
