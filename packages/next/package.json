{
  "name": "@cesium/next",
  "version": "2.0.0-poc.0",
  "private": true,
  "description": "Proof of concept for a WebGPU-native CesiumJS 2.0 engine.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "node bench/run.mjs"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/material": "9.5.0",
    "@stratakit/bricks": "0.6.1",
    "@stratakit/foundations": "1.0.4",
    "@stratakit/icons": "0.4.6",
    "@stratakit/mui": "1.2.0",
    "@stratakit/structures": "0.6.2",
    "@tanstack/react-router": "1.170.45",
    "draco3d": "1.5.7",
    "ktx-parse": "^2.0.0",
    "meshoptimizer": "^1.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@webgpu/types": "^0.1.74",
    "typescript": "^6.0.2",
    "vite": "8.0.16",
    "vitest": "^5.0.5"
  }
}
