    "wydot-spiral-example": {
      "source": {
        "document": "Wyoming Department of Transportation Survey Manual, Appendix D - Alignment and Superelevation",
        "revision": "Revised July, 2024",
        "section": "A.2.a General Spiral Equations, (1) Example Problem; Table D-1, Spiral table for LS = 150 ft; A.2.b Locating a point on a spiral curve (series for x, y; ST and LT)",
        "pages": "D-9 to D-11",
        "url": "https://www.dot.state.wy.us/files/live/sites/wydot/files/shared/Highway_Development/Surveys/Survey%20Manual/Appendix%20D%20-%20Alignment%20and%20Superelevation.pdf",
        "retrieved": "2026-11-06"
      },
      "given": {
        "piStation": "100+00",
        "LS": "150 ft",
        "delta": "35°",
        "D": "10°"
      },
      "solution": {
        "R": "5729.58 / 10 = 572.96 ft",
        "deltaS": "10 * 150 / 200 = 7.5°",
        "deltaC": "35° − 2 * 7.5° = 20°",
        "LC": "100 * 20 / 10 = 200.00 ft",
        "TS": "(572.96 + 1.64) tan 35/2 + 74.96 = 256.13 ft"
      },
      "tableRow": {
        "D": "10° 00’ 00”",
        "deltaS": "7° 30’ 00”",
        "R": "572.96",
        "X": "149.74",
        "Y": "6.54",
        "T": "1.64",
        "Q": "74.96",
        "LCS": "149.89",
        "ST": "50.08",
        "LT": "100.09"
      },
      "stations": {
        "TS": "97 + 43.87",
        "SC": "98 + 93.87",
        "CS": "100 + 93.87",
        "ST": "102 + 43.87"
      },
      "formulas": {
        "ST": "ST = Y / sin ∆S",
        "LT": "LT = X − ST cos ∆S",
        "TS": "TS = (R + T) tan ∆/2 + Q"
      },
      "note": "The example's text says the table values are for a spiral central angle of 10° 00’ 00”; the values quoted are Table D-1's row for D = 10° 00’ 00” (∆S = 7° 30’ 00”). Its SC line also misprints the TS station as 9843.87; the result, 9893.87 (98 + 93.87), follows from TS = 97 + 43.87. R is the arc definition, 5729.58/D."
    },
