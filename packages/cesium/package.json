{
  "name": "@cesium/next",
  "version": "2.0.0-poc.0",
  "private": true,
  "description": "Proof of concept for a WebGPU-native CesiumJS 2.0 engine.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "@cesium/source": "./src/index.ts",
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./time": {
      "@cesium/source": "./src/time.ts",
      "types": "./dist/types/time.d.ts",
      "default": "./dist/time.js"
    },
    "./frames": {
      "@cesium/source": "./src/frames.ts",
      "types": "./dist/types/frames.d.ts",
      "default": "./dist/frames.js"
    },
    "./crs": {
      "@cesium/source": "./src/crs.ts",
      "types": "./dist/types/crs.d.ts",
      "default": "./dist/crs.js"
    },
    "./measure": {
      "@cesium/source": "./src/measure.ts",
      "types": "./dist/types/measure.d.ts",
      "default": "./dist/measure.js"
    },
    "./ui": {
      "@cesium/source": "./src/ui.ts",
      "types": "./dist/types/ui.d.ts",
      "default": "./dist/ui.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE.md",
    "README.md"
  ],
  "dependencies": {
    "@cesium/core": "2.0.0-poc.0",
    "@cesium/crs": "2.0.0-poc.0",
    "@cesium/frames": "2.0.0-poc.0",
    "@cesium/measure": "2.0.0-poc.0",
    "@cesium/time": "2.0.0-poc.0",
    "@cesium/ui": "2.0.0-poc.0"
  }
}
