  },
  "files": [
    "dist",
    "LICENSE.md",
    "README.md",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "@cesium/core": "2.0.0-poc.0",
    "@cesium/time": "2.0.0-poc.0",
    "@cesium/frames": "2.0.0-poc.0"
  }
