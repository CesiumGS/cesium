{
  "name": "@cesium/ui",
  "version": "2.0.0-poc.0",
  "private": true,
  "description": "Cesium 2.0's widgets and the Viewer composed from them.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CesiumGS/cesium.git",
    "directory": "packages/ui"
  },
