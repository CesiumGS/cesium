{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rewriteRelativeImportExtensions": true,
    "rootDir": "src",
    "outDir": ".tsbuild",
    "types": [
      "@webgpu/types",
      "vite/client"
    ],
    "lib": [
      "ES2023",
      "ESNext.Disposable",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "include": [
    "src",
    "src/**/*.json"
  ],
  "references": [
    {
      "path": "../core"
    },
    {
      "path": "../time"
    }
  ]
}
