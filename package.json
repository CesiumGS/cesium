{
  "name": "cesium-workspace",
  "private": true,
  "description": "The Cesium 2.0 workspace: @cesium/next, Dyno and Sandcastle. Never published.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/CesiumGS/cesium.git"
  },
  "bugs": {
    "url": "https://github.com/CesiumGS/cesium/issues"
  },
  "type": "module",
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.15",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@lezer/highlight": "1.2.5",
    "@mui/material": "9.5.0",
    "@stratakit/bricks": "0.6.1",
    "@stratakit/foundations": "1.0.4",
    "@stratakit/icons": "0.4.6",
    "@stratakit/mui": "1.2.0",
    "@stratakit/structures": "0.6.2",
    "@tanstack/react-router": "1.170.45",
    "codemirror": "6.0.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@cesium/dyno": "0.0.0",
    "@cesium/eslint-config": "^14.0.0",
    "@cesium/next": "2.0.0-poc.0",
    "@changesets/cli": "3.0.3",
    "@playwright/test": "^1.62.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-basic-ssl": "2.3.0",
    "@webgpu/types": "^0.1.74",
    "cesium-1x": "npm:cesium@1.147.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-html": "^8.2.0",
    "eslint-plugin-jsdoc": "^65.2.1",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "eslint-seatbelt": "^0.1.3",
    "globals": "^17.11.0",
    "human-in-the-lead": "git+https://github.com/arobison/human-in-the-lead.git#v0.1.0-rc.1",
    "husky": "^9.0.7",
    "markdownlint-cli": "^0.50.0",
    "naga-wasm": "30.2.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "publint": "0.3.25",
    "sharp": "0.35.5",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "8.0.16",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dyno": "node bench/suite/commands/serve.mjs",
    "dyno:serve": "vite --host 127.0.0.1 --port 5190 --strictPort",
    "dyno:cli": "node bench/dyno.mjs",
    "build": "node scripts/build.mjs",
    "build:site": "vite build",
    "typecheck": "tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:data": "FRAMES_DATA=1 vitest run test/data",
    "bench": "node bench/run.mjs",
    "slang": "node scripts/slangShader.mjs",
    "shaders": "node scripts/slangBuild.mjs",
    "shaders:check": "node scripts/slangBuild.mjs --check",
    "surface": "node scripts/surfaceMap.mjs --write",
    "changeset": "changeset",
    "changeset:check": "node scripts/release/changesetCheck.mjs",
    "release:version": "node scripts/release/version.mjs",
    "release:check": "node scripts/release/lines.mjs --check",
    "release:notes": "node scripts/release/notes.mjs",
    "release:stage": "node scripts/release/stage.mjs",
    "check:bundle": "node scripts/checkBundle.mjs",
    "handbook:data": "node scripts/handbookData.mjs",
    "handbook": "node scripts/handbookData.mjs && tsc -p handbook && vite build --config handbook/vite.config.ts",
    "handbook:dev": "node scripts/handbookData.mjs --no-bundles && vite --config handbook/vite.config.ts",
    "handbook:serve": "npm run handbook:dev -- --port 5199 --strictPort",
    "setup": "node scripts/setup.mjs",
    "sky": "node scripts/skyPack.mjs",
    "hitld:setup": "cd \"$(git rev-parse --show-toplevel)\" && claude plugin marketplace add arobison/human-in-the-lead#v0.1.0-rc.1 --scope project && claude plugin install human-in-the-lead@human-in-the-lead --scope project && hitld install --ref v0.1.0-rc.1 --repo arobison/human-in-the-lead",
    "prepare": "husky",
    "build-sandcastle": "npm run build --workspace @cesium/sandcastle",
    "create-demo": "npm run create-demo --workspace=apps/sandcastle",
    "eslint": "eslint \"./**/*.*js\" \"./**/*.*ts*\" \"./**/*.html\" --cache --quiet",
    "markdownlint": "markdownlint \"**/*.md\"",
    "prettier": "prettier --write \"**/*\"",
    "prettier-check": "prettier --check \"**/*\""
  },
  "engines": {
    "node": ">=22.17.0"
  },
  "packageManager": "pnpm@11.12.0",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ]
}
