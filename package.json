{
  "name": "cesium-workspace",
  "private": true,
  "description": "The Cesium 2.0 workspace: @cesium/next, Dyno and Sandcastle. Never published.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/CesiumGS/cesium.git"
  },
  "bugs": {
    "url": "https://github.com/CesiumGS/cesium/issues"
  },
  "type": "module",
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.15",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@lezer/highlight": "1.2.5",
    "@mui/material": "9.5.0",
    "@stratakit/bricks": "0.6.1",
    "@stratakit/foundations": "1.0.4",
    "@stratakit/icons": "0.4.6",
    "@stratakit/mui": "1.2.0",
    "@stratakit/structures": "0.6.2",
    "@tanstack/react-router": "1.170.45",
    "codemirror": "6.0.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cesium/eslint-config": "^14.0.0",
    "@playwright/test": "^1.62.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-basic-ssl": "2.3.0",
    "@webgpu/types": "^0.1.74",
    "cesium-1x": "npm:cesium@1.147.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-html": "^8.2.0",
    "eslint-plugin-jsdoc": "^65.2.1",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "eslint-seatbelt": "^0.1.3",
    "globals": "^17.11.0",
    "human-in-the-lead": "git+https://github.com/arobison/human-in-the-lead.git#v0.1.0-rc.1",
    "husky": "^9.0.7",
    "markdownlint-cli": "^0.50.0",
    "naga-wasm": "30.2.0",
    "prettier": "3.9.10",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "8.0.16",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "prepare": "husky",
    "test": "npm test --workspace @cesium/next",
    "build-sandcastle": "npm run build --workspace @cesium/sandcastle",
    "create-demo": "npm run create-demo --workspace=packages/sandcastle",
    "eslint": "eslint \"./**/*.*js\" \"./**/*.*ts*\" \"./**/*.html\" --cache --quiet",
    "markdownlint": "markdownlint \"**/*.md\"",
    "prettier": "prettier --write \"**/*\"",
    "prettier-check": "prettier --check \"**/*\""
  },
  "engines": {
    "node": ">=22.17.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*",
    "packages/next/tools/dyno"
  ],
  "overrides": {
    "protobufjs": "^8.8.0",
    "@huggingface/transformers": {
      "onnxruntime-web": {
        "protobufjs": "^7.6.4"
      }
    },
    "allotment": {
      "use-resize-observer": {
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
      }
    }
  }
}
